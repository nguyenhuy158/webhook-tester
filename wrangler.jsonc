{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webhook-tester",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ACCESS_TOKEN_EXPIRE_MINUTES": "1440"
  },
  "workers_dev": false,
  "routes": [{ "pattern": "hooks.huyab.click", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      // Shared with other projects, hence the webhook_tester_ table prefix.
      "database_name": "db",
      "database_id": "6eb9cfce-f6f3-4476-8e46-7c8e954d93c1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ENDPOINT_HUB",
        "class_name": "EndpointHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed Durable Objects work on the Workers free plan.
      "new_sqlite_classes": ["EndpointHub"]
    }
  ]
}
