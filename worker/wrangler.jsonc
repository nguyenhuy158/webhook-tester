{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webhook-tester",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALGORITHM": "HS256",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "1440",
    "DEFAULT_USERNAME": "huy"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webhook-tester",
      // Replace with the id printed by: wrangler d1 create webhook-tester
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ENDPOINT_HUB",
        "class_name": "EndpointHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed Durable Objects work on the Workers free plan.
      "new_sqlite_classes": ["EndpointHub"]
    }
  ]
}
